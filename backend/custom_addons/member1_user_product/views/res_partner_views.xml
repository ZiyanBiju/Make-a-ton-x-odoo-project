<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_subscription" model="ir.ui.view">
        <field name="name">res.partner.form.subscription</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Subscription Details">
                    <group>
                        <field name="customer_code"/>
                        <field name="customer_category"/>
                        <field name="is_subscription_customer"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>