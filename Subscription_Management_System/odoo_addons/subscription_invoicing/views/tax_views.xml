<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_tax_rate_tree" model="ir.ui.view">
        <field name="name">subscription.tax.rate.tree</field>
        <field name="model">subscription.tax.rate</field>
        <field name="arch" type="xml">
            <list string="GST Rates">
                <field name="name"/>
                <field name="rate"/>
                <field name="description"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_subscription_tax_rate" model="ir.actions.act_window">
        <field name="name">GST Rates Configuration</field>
        <field name="res_model">subscription.tax.rate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
