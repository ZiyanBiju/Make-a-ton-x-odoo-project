<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_invoice_tree" model="ir.ui.view">
        <field name="name">subscription.invoice.tree</field>
        <field name="model">subscription.invoice</field>
        <field name="arch" type="xml">
            <list string="Subscription Invoices">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="customer_state"/>
                <field name="subtotal"/>
                <field name="discount_amount"/>
                <field name="total_tax"/>
                <field name="total_amount"/>
                <field name="status" widget="badge" decoration-success="status == 'Paid'" decoration-info="status == 'Posted'" decoration-danger="status == 'Cancelled'"/>
                <field name="issue_date"/>
                <field name="due_date"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_invoice_form" model="ir.ui.view">
        <field name="name">subscription.invoice.form</field>
        <field name="model">subscription.invoice</field>
        <field name="arch" type="xml">
            <form string="Subscription Invoice">
                <header>
                    <button name="action_post" string="Post Invoice" type="object" class="oe_highlight" invisible="status != 'Draft'"/>
                    <button name="action_paid" string="Mark as Paid" type="object" class="oe_highlight" invisible="status != 'Posted'"/>
                    <button name="action_cancel" string="Cancel Invoice" type="object" invisible="status in ('Cancelled', 'Paid')"/>
                    <field name="status" widget="statusbar" statusbar_visible="Draft,Posted,Paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer Details">
                            <field name="partner_name"/>
                            <field name="partner_email"/>
                            <field name="customer_state"/>
                            <field name="customer_gstin"/>
                            <field name="customer_address"/>
                        </group>
                        <group string="Invoice Details">
                            <field name="subscription_id"/>
                            <field name="billing_cycle_start"/>
                            <field name="billing_cycle_end"/>
                            <field name="issue_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="tax_rate"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="subtotal"/>
                                <field name="discount_amount"/>
                                <field name="taxable_amount"/>
                                <field name="cgst_amount" invisible="is_inter_state"/>
                                <field name="sgst_amount" invisible="is_inter_state"/>
                                <field name="igst_amount" invisible="not is_inter_state"/>
                                <field name="total_tax"/>
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes or payment terms..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_invoice" model="ir.actions.act_window">
        <field name="name">Subscription Invoices</field>
        <field name="res_model">subscription.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
